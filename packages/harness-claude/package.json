{
  "name": "@openagent/harness-claude",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Harness plugin for OpenAgent: self-registration main and renderer modules.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main/entry.d.ts",
      "default": "./dist/main/entry.js"
    },
    "./renderer": {
      "types": "./dist/renderer/entry.d.ts",
      "default": "./dist/renderer/entry.js"
    },
    "./package.json": "./package.json",
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./test-support": {
      "types": "./dist/test-support/index.d.ts",
      "default": "./dist/test-support/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node copy-assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@openagent/contracts": "workspace:*",
    "@openagent/plugin-kit": "workspace:*",
    "cross-spawn": "^7.0.6"
  },
  "peerDependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@openagent/test-kit": "workspace:*",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  }
}
