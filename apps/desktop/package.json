{
  "name": "openagent-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet desktop workspace for local agent CLIs.",
  "main": "./out/main/index.js",
  "scripts": {
    "generate:registry": "node ../../scripts/build-packages.mjs && node scripts/generate-harness-registry.mjs",
    "dev": "node scripts/watch-desktop.mjs",
    "playground:thread": "node scripts/watch-desktop.mjs --playground",
    "playground:thread:build": "pnpm playground:thread:check && vite build --config playgrounds/thread-detail/vite.config.ts",
    "playground:thread:check": "pnpm generate:registry && tsc --noEmit -p playgrounds/thread-detail/tsconfig.json",
    "lab:thread": "node scripts/watch-desktop.mjs --single-thread",
    "lab:thread:check": "pnpm generate:registry && tsc --noEmit -p playgrounds/single-thread/tsconfig.json",
    "lab:thread:build": "pnpm lab:thread:check && vite build --config playgrounds/single-thread/vite.config.ts",
    "lab:bart": "pnpm generate:registry && vite --config labs/bart/vite.config.ts",
    "lab:bart:build": "pnpm typecheck:app && vite build --config labs/bart/vite.config.ts",
    "build": "pnpm typecheck:app && pnpm build:bundles",
    "typecheck": "pnpm typecheck:app && pnpm typecheck:tests && tsc --noEmit -p playgrounds/thread-detail/tsconfig.json && tsc --noEmit -p playgrounds/single-thread/tsconfig.json && tsc --noEmit -p playgrounds/overview-motion/tsconfig.json && tsc --noEmit -p playgrounds/bart-thread-transition/tsconfig.json && tsc --noEmit -p playgrounds/mermaid-thread/tsconfig.json",
    "typecheck:app": "pnpm generate:registry && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "pnpm generate:registry && vitest run --maxWorkers=4 --testTimeout=15000",
    "test:watch": "node scripts/watch-desktop.mjs --test",
    "test:bart-headless": "pnpm build && node tests/bart-headless-acceptance.mjs",
    "test:bart-headless:pbt": "pnpm build && node tests/bart-headless-pbt.mjs run",
    "test:bart-headless:pbt:explore": "pnpm build && node tests/bart-headless-pbt.mjs explore",
    "test:bart-headless:pbt:replay": "node tests/bart-headless-pbt.mjs replay",
    "test:harness-health": "pnpm build && node tests/harness-health.mjs",
    "perf:bench": "pnpm generate:registry && vitest bench --run",
    "test:liquid-runtime": "node tests/liquid-capture.electron.mjs",
    "test:report-runtime": "node tests/report-runtime.electron.mjs",
    "test:appearance-runtime": "node tests/application-appearance.electron.mjs",
    "test:lifecycle-runtime": "node tests/app-lifecycle.electron.mjs && node tests/application-appearance.electron.mjs",
    "perf:markdown:build": "pnpm generate:registry && vite build --config benchmarks/vite.markdown-bench.config.ts",
    "perf:markdown:serve": "vite preview --config benchmarks/vite.markdown-bench.config.ts --port 4175 --strictPort",
    "perf:renderer:build": "pnpm generate:registry && tsc --noEmit -p benchmarks/tsconfig.renderer-bench.json && vite build --config benchmarks/vite.renderer-bench.config.ts",
    "perf:renderer:serve": "vite preview --config benchmarks/vite.renderer-bench.config.ts --port 4177 --strictPort",
    "pack": "pnpm build && electron-builder --dir",
    "pack:local:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false pnpm run pack --mac --arm64 --config.electronDist=node_modules/electron/dist",
    "dist": "pnpm build && electron-builder",
    "test:layout": "pnpm generate:registry && vitest run tests/property/overview-layout.property.test.ts tests/property/overview-layout-search.property.test.ts --maxWorkers=2 --testTimeout=15000",
    "playground:overview": "node scripts/watch-desktop.mjs --overview-motion",
    "playground:overview:build": "pnpm playground:overview:check && vite build --config playgrounds/overview-motion/vite.config.ts",
    "playground:overview:check": "pnpm generate:registry && tsc --noEmit -p playgrounds/overview-motion/tsconfig.json",
    "playground:bart-transition": "node scripts/watch-desktop.mjs --bart-transition",
    "playground:bart-transition:build": "pnpm playground:bart-transition:check && vite build --config playgrounds/bart-thread-transition/vite.config.ts",
    "playground:bart-transition:check": "pnpm generate:registry && tsc --noEmit -p playgrounds/bart-thread-transition/tsconfig.json",
    "playground:mermaid": "node scripts/watch-desktop.mjs --mermaid-thread",
    "playground:mermaid:build": "pnpm playground:mermaid:check && vite build --config playgrounds/mermaid-thread/vite.config.ts",
    "playground:mermaid:check": "pnpm generate:registry && tsc --noEmit -p playgrounds/mermaid-thread/tsconfig.json",
    "test:mermaid-browser": "node tests/mermaid-thread.browser.mjs",
    "build:bundles": "node ../../scripts/cached-build.mjs desktop",
    "build:main": "node scripts/build-target.mjs main",
    "build:preload": "node scripts/build-target.mjs preload",
    "build:renderer": "node scripts/build-target.mjs renderer",
    "test:bart-isolation": "node tests/bart-worker-suite.mjs"
  },
  "dependencies": {
    "@openagent/harness-codex": "workspace:*",
    "@openagent/harness-claude": "workspace:*",
    "@openagent/contracts": "workspace:*",
    "@openagent/plugin-kit": "workspace:*",
    "cross-spawn": "^7.0.6",
    "entities": "6.0.1",
    "zod": "4.5.4",
    "@openagent/harness-pi": "workspace:*"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@liquid-dom/react": "0.1.1",
    "@openagent/test-kit": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "character-entities": "^2.0.2",
    "electron": "44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "fast-check": "4.9.0",
    "html-to-image": "1.11.13",
    "html-url-attributes": "^3.0.1",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.544.0",
    "playwright": "^1.59.1",
    "property-information": "^7.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "5.0.15",
    "llm-mock-server": "1.1.0"
  },
  "build": {
    "appId": "com.openagent.desktop",
    "productName": "Agent Workspace",
    "afterPack": "../../scripts/dev-app-lib.mjs",
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
