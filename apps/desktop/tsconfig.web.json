{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "composite": true
  },
  "include": [
    "labs/bart/src/**/*.ts",
    "labs/bart/src/**/*.tsx",
    "src/renderer/**/*.ts",
    "src/renderer/**/*.tsx",
    "src/renderer/**/*.d.ts",
    "src/shared/**/*.ts",
    "src/generated/**/*.ts",
    "../../packages/harness-*/src/shared/**/*.ts",
    "../../packages/harness-*/src/renderer/**/*.ts",
    "../../packages/harness-*/src/renderer/**/*.tsx",
    "../../packages/openagent-plugin-kit/src/renderer/**/*.ts",
    "../../packages/openagent-plugin-kit/src/renderer/**/*.tsx",
    "../../packages/openagent-plugin-kit/src/renderer/**/*.d.ts",
    "../../packages/openagent-plugin-kit/src/shared/**/*.ts",
    "playgrounds/bart-thread-transition/src/**/*",
    "playgrounds/single-thread/src/**/*.ts"
  ]
}
